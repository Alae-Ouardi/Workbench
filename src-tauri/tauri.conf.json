{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskBoard",
  "version": "0.2.4",
  "identifier": "com.alae.taskboard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaskBoard",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "tray",
        "title": "TaskBoard",
        "url": "index.html",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "width": 380,
        "height": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
